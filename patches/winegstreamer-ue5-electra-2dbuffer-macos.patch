+ * NOTE for review: video_decoder.c is the PE module, cross-compiled for Windows,
+ * so __APPLE__ is NOT defined here -- host-OS detection must be a RUNTIME check
+ * (e.g. a winegstreamer unix-call, as the unix side links against the host libc).
+ * This stub only encodes the intent; a real submission must wire up that call. */
+static inline BOOL is_macos(void)
+{
+    return TRUE; /* PLACEHOLDER -- replace with a runtime host-OS check */
+}
+
 struct subtype_info
 {
     const GUID *subtype;
@@ -780,11 +793,13 @@ static HRESULT WINAPI transform_ProcessMessage(IMFTransform *iface, MFT_MESSAGE_
     switch (message)
     {
     case MFT_MESSAGE_SET_D3D_MANAGER:
+        if (is_macos() && param)
+            return E_NOTIMPL;   /* no NV12 D3D11 textures on macOS; force system memory */
         if (FAILED(hr = IMFVideoSampleAllocatorEx_SetDirectXManager(decoder->allocator, (IUnknown *)param)))
             return hr;
 
         uninit_allocator(decoder);
-        if (param)
+        if (param || is_macos())
             decoder->output_info.dwFlags |= MFT_OUTPUT_STREAM_PROVIDES_SAMPLES;
         else
             decoder->output_info.dwFlags &= ~MFT_OUTPUT_STREAM_PROVIDES_SAMPLES;
@@ -918,8 +933,17 @@ static HRESULT WINAPI transform_ProcessOutput(IMFTransform *iface, DWORD flags,
                 decoder->temp_buffer = NULL;
             }
         }
-        if (!decoder->temp_buffer && FAILED(hr = MFCreateMemoryBuffer(sample_size, &decoder->temp_buffer)))
-            return hr;
+        if (!decoder->temp_buffer)
+        {
+            if (is_macos())
+                /* IMF2DBuffer2-capable buffer: fourcc is the video subtype's Data1. */
+                hr = MFCreate2DMediaBuffer(frame_size >> 32, (UINT32)frame_size,
+                        subtype.Data1, FALSE, &decoder->temp_buffer);
+            else
+                hr = MFCreateMemoryBuffer(sample_size, &decoder->temp_buffer);
+            if (FAILED(hr))
+                return hr;
+        }
         if (FAILED(hr = MFCreateSample(&sample)))
             return hr;
         if (FAILED(hr = IMFSample_AddBuffer(sample, decoder->temp_buffer)))
@@ -1558,12 +1582,17 @@ static HRESULT video_decoder_create_with_types(const GUID *const *input_types, U
     if (FAILED(hr = MFCreateAttributes(&decoder->attributes, 16)))
         goto failed;
