+/* Distinguish flow returns that permanently break the chain from those that
+ * occur in normal operation. GST_FLOW_FLUSHING and GST_FLOW_EOS are expected
+ * during seeks, drains and end of stream and must not poison the transform. */
+static bool flow_return_is_fatal(GstFlowReturn ret)
+{
+    switch (ret)
+    {
+    case GST_FLOW_NOT_LINKED:
+    case GST_FLOW_NOT_NEGOTIATED:
+    case GST_FLOW_ERROR:
+    case GST_FLOW_NOT_SUPPORTED:
+        return true;
+    default:
+        return false;
+    }
+}
