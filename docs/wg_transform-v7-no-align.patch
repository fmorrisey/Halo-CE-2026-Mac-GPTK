+/* GstVideoDecoder tolerates decode errors indefinitely by default
+ * (max-errors = -1): a decoder that rejects every packet it is given keeps
+ * returning GST_FLOW_OK while producing nothing, and upstream cannot tell it
+ * apart from a healthy decoder waiting for input. The error counter resets
+ * whenever a frame is actually pushed out, so a finite limit means "this many
+ * consecutive failures with no output", which is a dead decoder. One GOP at
+ * typical keyframe intervals is a generous budget. */
+#define WG_DECODER_MAX_CONSECUTIVE_ERRORS 30
+
+static void set_max_errors(GstElement *element)
+{
+    if (!GST_IS_VIDEO_DECODER(element))
+        return;
+    gst_video_decoder_set_max_errors(GST_VIDEO_DECODER(element), WG_DECODER_MAX_CONSECUTIVE_ERRORS);
+}
